# New Supabase project (PT. Vinix Seven Aurum Lost & Found)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (service role for notifications/admin tasks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Company email restriction (comma-separated domains, without @). Example: vinixsevenaurum.co.id
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=vinixsevenaurum.co.id
